import numpy as np
from desidlas.prediction.pred_sightline import save_pred
from desidlas.prediction.multiprocess_partprediction import predictions_desi
import time
############DESI data
sightline_total = '/global/cfs/cdirs/desi/users/jqzou/jura/sightlines_main_dark'
#'/global/cfs/cdirs/desi/users/tingtan/DLA_finder/mocks/iron_london/sightlines'

list1 = os.listdir(sightline_total)
sightline_list=[]
partpre_list=[]
dlacat_list=[]
for k in list1:

    list2=os.listdir(sightline_total+'/'+str(k)) 
    for j in list2:
        if j.endswith('-pre-sightlines.npy'):
            sightline_list.append(sightline_total+'/'+str(k)+'/'+j) 
            partpre_list.append(sightline_total+'/'+str(k)+'/'+j.replace('-pre-sightlines.npy','-pre-sightlines-pred.npy')) 
            dlacat_list.append(sightline_total+'/'+str(k)+'/'+j.replace('-pre-sightlines.npy','-dlacat.fits')) 
sightline_total_list = np.array(sightline_list)
partpre_total_list = np.array(partpre_list)
dlacat_total_list = np.array(dlacat_list)
print(dlacat_total_list.shape)   

for order,sightline_path in enumerate(sightline_total_list[0:10]):
    order = order+13000
    sightline_loc=sightline_total_list[order]#sightline_path+'/sightlines-{}.npy'.format(j)
    partpre_loc=partpre_total_list[order]#sightline_path+'/sightlines-{}-pred.npy'.format(j)
    dlacat_loc=dlacat_total_list[order]#sightline_path+'/dlacat-{}.fits'.format(j)
    print(sightline_loc,partpre_loc,dlacat_loc)

    start_time = time.time()
    predictions_desi(sightline_loc,partpre_loc)
    end_time = time.time()
    print("Predicting sightlines time: {} seconds".format(end_time - start_time))
    start_time = time.time()

    pred=np.load(partpre_loc,allow_pickle=True)
    sightlines=np.load(sightline_loc,allow_pickle=True)
    
    pred=np.load(partpre_loc,allow_pickle=True)
    sightlines=np.load(sightline_loc,allow_pickle=True)
    dla_tbl=save_pred(sightlines,pred,filename=dlacat_loc)
    
